+class TestPackFileSignature:
+    # Captured from the official VeSync Android app 5.6.60 (pyvesync issue #477).
+    @pytest.mark.parametrize(
+        ('trace_id', 'expected'),
+        [
+            ('1765251913564', 'ae2f6d63d00ae9f5d4b866dd472b54d1c66d98fe159801adb494785d84f3bb2e'),
+            ('1765251914109', 'a2af15ba8943e8edf16d1680eed70f57d19ba0026d6a9233ea76e25e3c310c70'),
+        ],
+    )
+    def test_matches_app_captures(self, trace_id, expected):
+        assert generate_pack_file_signature(trace_id) == f'v0001-{expected}'
+
+    def test_header_signs_body_trace_id(self):
+        async def run():
+            manager = make_manager()
+            device = make_pet_pro(manager)
+            sent = {}
+
+            class FakeResponse:
+                status = 200
+
+                async def read(self):
+                    return b'{"code": 0, "msg": "ok", "result": {"code": 0, "result": {}}}'
+
+                async def __aenter__(self):
+                    return self
+
+                async def __aexit__(self, *args):
+                    return False
+
+            def fake_request(method, url, json, headers, raise_for_status):
+                sent['json'], sent['headers'] = json, headers
+                return FakeResponse()
+
+            manager.session = MagicMock()
+            manager.session.request = fake_request
+            await device.call_bypassv2_api('setChildLock', {'childLockSwitch': 1})
+            trace_id = sent['json']['traceId']
+            expected = hashlib.sha256((trace_id + VESYNC_CERT_SHA1).encode()).hexdigest()
+            assert sent['headers']['_packFileSignature'] == f'v0001-{expected}'
+            assert sent['headers']['_signOsInfo'] == 'Android'
+
+        asyncio.run(run())
