diff --git a/src/tests/test_vendor_ha.py b/src/tests/test_vendor_ha.py
new file mode 100644
index 0000000..bd907ed
--- /dev/null
+++ b/src/tests/test_vendor_ha.py
@@ -0,0 +1,126 @@
+"""Behaviour required when this library runs next to Home Assistant's own vesync integration."""
+
+import asyncio
+import json
+import platform
+import uuid
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from pyvesync import VeSync, const
+from pyvesync.device_map import get_device_config
+from pyvesync.devices.vesyncpurifier import VeSyncAirBaseV2
+from pyvesync.models.vesync_models import ResponseDeviceDetailsModel
+from pyvesync.utils.errors import VeSyncTokenError
+
+from test_petpro import DEVICE_LIST_ITEM
+
+TOKEN_EXPIRED = {'code': -11001000, 'msg': 'token expired'}
+OK = {'code': 0, 'msg': 'ok', 'result': {'code': 0, 'result': {'powerSwitch': 1}}}
+
+
+def stock_terminal_id() -> str:
+    """The formula used by upstream pyvesync (and so by HA's vesync integration)."""
+    return '2' + uuid.uuid5(
+        uuid.NAMESPACE_DNS, f'{uuid.getnode():x}-{platform.node() or ""}'
+    ).hex
+
+
+def test_terminal_id_differs_from_stock_but_is_stable():
+    assert const.TERMINAL_ID != stock_terminal_id()
+    assert const.TERMINAL_ID.startswith('2') and len(const.TERMINAL_ID) == 33
+
+
+class FakeSession:
+    """Rejects any request carrying a token other than the current valid one."""
+
+    def __init__(self, manager):
+        self.manager = manager
+        self.valid_token = 'TOKEN_TWO'
+        self.bodies = []
+
+    def request(self, method, url, json=None, headers=None, raise_for_status=False):
+        self.bodies.append(json)
+        body = OK if (json or {}).get('token') == self.valid_token else TOKEN_EXPIRED
+        return FakeResponse(body)
+
+
+class FakeResponse:
+    status = 200
+
+    def __init__(self, body):
+        self._body = json.dumps(body).encode()
+
+    async def read(self):
+        return self._body
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *args):
+        return False
+
+
+def make():
+    manager = VeSync('user@example.com', 'password')
+    manager.set_credentials('TOKEN_ONE', 'ACCOUNT', 'US', 'US')
+    manager.session = FakeSession(manager)
+    details = ResponseDeviceDetailsModel.from_dict(DEVICE_LIST_ITEM)
+    device = VeSyncAirBaseV2(details, manager, get_device_config('LAP-P501S-WUSR'))
+
+    async def fake_reauth():
+        manager.set_credentials('TOKEN_TWO', 'ACCOUNT', 'US', 'US')
+        return True
+
+    return manager, device, fake_reauth
+
+
+def test_rejected_token_retries_once_with_new_token():
+    async def run():
+        manager, device, fake_reauth = make()
+        with patch.object(type(manager.auth), 'reauthenticate', AsyncMock(side_effect=fake_reauth)) as login:
+            resp = await device.call_bypassv2_api('getPurifierStatus')
+            assert resp['code'] == 0
+            assert login.await_count == 1
+            assert [b['token'] for b in manager.session.bodies] == ['TOKEN_ONE', 'TOKEN_TWO']
+            assert manager.session.bodies[0]['traceId'] is not None
+
+    asyncio.run(run())
+
+
+def test_retry_keeps_signature_headers():
+    async def run():
+        manager, device, fake_reauth = make()
+        seen = []
+        orig = manager.session.request
+
+        def spy(method, url, json=None, headers=None, raise_for_status=False):
+            seen.append(dict(headers or {}))
+            return orig(method, url, json=json, headers=headers, raise_for_status=raise_for_status)
+
+        manager.session.request = spy
+        with patch.object(type(manager.auth), 'reauthenticate', AsyncMock(side_effect=fake_reauth)):
+            await device.call_bypassv2_api('setChildLock', {'childLockSwitch': 1})
+        assert len(seen) == 2
+        assert all(h.get('_packFileSignature', '').startswith('v0001-') for h in seen)
+
+    asyncio.run(run())
+
+
+def test_reauth_is_rate_limited():
+    async def run():
+        manager, device, _ = make()
+        manager.session.valid_token = 'NEVER_VALID'
+
+        async def still_bad():
+            manager.set_credentials('TOKEN_TWO', 'ACCOUNT', 'US', 'US')
+            return True
+
+        with patch.object(type(manager.auth), 'reauthenticate', AsyncMock(side_effect=still_bad)) as login:
+            for _ in range(5):
+                with pytest.raises(VeSyncTokenError):
+                    await device.call_bypassv2_api('getPurifierStatus')
+            assert login.await_count == 1
+
+    asyncio.run(run())
