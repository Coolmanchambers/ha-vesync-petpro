     async def _reauthenticate(self) -> bool:
         """Re-authenticate using stored username and password.
 
+        At most one attempt per REAUTH_COOLDOWN seconds, so a token that keeps
+        being rejected cannot turn into a login storm and an account lockout.
+
         Returns:
             True if re-authentication successful, False otherwise
         """
+        now = time.monotonic()
+        if self._last_reauth is not None and now - self._last_reauth < REAUTH_COOLDOWN:
+            logger.warning(
+                'Token rejected again within %s s of the last login; skipping login',
+                REAUTH_COOLDOWN,
